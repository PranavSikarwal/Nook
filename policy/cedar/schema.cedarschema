namespace Nook {
  entity User;

  entity Tool {
    name: String,
    read_only: Bool,
  };

  action "web_search" appliesTo {
    principal: [User],
    resource: [Tool],
    context: {
      chat_id: String,
      approval_tier: String,
      grant_scope: String,
    }
  };

  action "web_fetch" appliesTo {
    principal: [User],
    resource: [Tool],
    context: {
      chat_id: String,
      host: String,
      url: String,
      approval_tier: String,
      grant_scope: String,
      argument_digest: String,
    }
  };

  action "read_local_file", "list_local_directory", "write_local_file" appliesTo {
    principal: [User],
    resource: [Tool],
    context: {
      chat_id: String,
      path: String,
      root: String,
      access: String,
      approval_tier: String,
      grant_scope: String,
      argument_digest: String,
    }
  };
}
