namespace Nook {
  entity User;

  entity Tool {
    name: String,
    read_only: Bool,
  };

  action "web_search", "news_search", "image_search", "video_search", "book_search" appliesTo {
    principal: [User],
    resource: [Tool],
    context: {
      chat_id: String,
      approval_tier: String,
      grant_scope: String,
    }
  };

  action "web_fetch" appliesTo {
    principal: [User],
    resource: [Tool],
    context: {
      chat_id: String,
      host: String,
      url: String,
      approval_tier: String,
      grant_scope: String,
      argument_digest: String,
    }
  };

  action "read_local_file", "list_local_directory", "write_local_file" appliesTo {
    principal: [User],
    resource: [Tool],
    context: {
      chat_id: String,
      path: String,
      root: String,
      access: String,
      approval_tier: String,
      grant_scope: String,
      argument_digest: String,
    }
  };

  action "mcp_call" appliesTo {
    principal: [User],
    resource: [Tool],
    context: {
      chat_id: String,
      server: String,
      tool: String,
      approval_tier: String,
      grant_scope: String,
      argument_digest: String,
    }
  };

  action "run_command" appliesTo {
    principal: [User],
    resource: [Tool],
    context: {
      chat_id: String,
      executable: String,
      executable_name: String,
      command_line: String,
      cwd: String,
      root: String,
      access: String,
      network: String,
      approval_tier: String,
      grant_scope: String,
      argument_digest: String,
    }
  };
}
