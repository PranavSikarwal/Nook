#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = [
#     "jsonschema>=4.20.0",
#     "pytest>=8.0.0",
# ]
# ///
"""Executable contract verification runner for Nook.

Validates all contract examples against schemas and runs the contract test suite.
Exits 0 on success, non-zero on failure.
"""

from __future__ import annotations

import sys
from pathlib import Path

import pytest

REPO_ROOT = Path(__file__).resolve().parent.parent
TESTS_DIR = REPO_ROOT / "tests" / "contracts"


def main() -> int:
    print(f"Running contract validation suite in {TESTS_DIR}...")
    exit_code = pytest.main(["-v", str(TESTS_DIR)])
    if exit_code == 0:
        print("PASS: all contract validation tests passed.")
    else:
        print(f"FAIL: contract validation failed with exit code {exit_code}.")
    return int(exit_code)


if __name__ == "__main__":
    sys.exit(main())
